<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_card_installment.CardInstallmentPopup" owl="1">
        <div class="modal-dialog">
            <div class="popup popup-textinput">
                <div class="popup-title"><t t-esc="props.title"/></div>
                <div class="popup-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Método de pago</label>
                            <input class="form-control" t-att-value="state.payment_method_label" readonly="readonly"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tarjeta</label>
                            <select class="form-select" t-on-change="onChangeBrand">
                                <option value="">Seleccionar</option>
                                <t t-foreach="brands" t-as="brand" t-key="brand.id">
                                    <option t-att-value="brand.id" t-att-selected="brand.id === state.card_brand_id"><t t-esc="brand.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cuotas</label>
                            <select class="form-select" t-on-change="onChangePlan">
                                <option value="">Seleccionar</option>
                                <t t-foreach="plans" t-as="plan" t-key="plan.id">
                                    <option t-att-value="plan.id" t-att-selected="plan.id === state.installment_plan_id">
                                        <t t-esc="plan.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Monto neto</label>
                            <input type="number" class="form-control" t-att-value="state.net_amount" t-on-input="onChangeNetAmount"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Recargo</label>
                            <input class="form-control" t-att-value="state.surcharge_amount.toFixed(2)" readonly="readonly"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Importe</label>
                            <input class="form-control" t-att-value="state.total_amount.toFixed(2)" readonly="readonly"/>
                        </div>
                    </div>
                </div>
                <div class="footer d-flex justify-content-end gap-2 pt-3">
                    <button class="button cancel btn btn-secondary" t-on-click="cancel"><t t-esc="props.cancelText"/></button>
                    <button class="button confirm btn btn-primary" t-on-click="confirm"><t t-esc="props.confirmText"/></button>
                </div>
            </div>
        </div>
    </t>
</templates>
