<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_card_installment.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div class="card p-3 mt-2" t-if="pciCurrentPaymentLine and pciCurrentPaymentLine.payment_method?.pci_use_card_installment">
                <div class="fw-bold mb-2">Tarjetas de crédito</div>
                <div class="mb-1"><strong>Método de pago:</strong> <t t-esc="pciCurrentPaymentLine.payment_method.name"/></div>
                <div class="mb-1"><strong>Tarjeta:</strong> <t t-esc="pciCurrentLineCardBrandName or '-'"/></div>
                <div class="mb-1"><strong>Cuotas:</strong> <t t-esc="pciCurrentPaymentLine.pci_installments or 1"/></div>
                <div class="mb-1"><strong>Monto Neto:</strong> <t t-esc="(pciCurrentPaymentLine.pci_net_amount || pciCurrentPaymentLine.amount || 0).toFixed(2)"/></div>
                <div class="mb-1"><strong>Recargo:</strong> <t t-esc="(pciCurrentPaymentLine.pci_surcharge_amount || 0).toFixed(2)"/></div>
                <div class="mb-2"><strong>Total Pago:</strong> <t t-esc="(pciCurrentPaymentLine.pci_total_amount || pciCurrentPaymentLine.amount || 0).toFixed(2)"/></div>
                <button class="btn btn-primary w-100" t-on-click="pciOpenInstallmentPopup">Editar tarjeta / cuotas</button>
            </div>
        </xpath>
    </t>
</templates>
