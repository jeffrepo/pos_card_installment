<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_card_installment.CardInstallmentPopup">
        <Dialog title="props.title || 'Tarjeta / Cuotas'">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Método de pago</label>
                    <input
                        class="form-control"
                        t-att-value="props.paymentMethod?.name || ''"
                        readonly="readonly"
                    />
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Tarjeta</label>
                        <select class="form-select" t-on-change="onChangeCard">
                            <t t-if="state.cards.length">
                                <t t-foreach="state.cards" t-as="card" t-key="card.id">
                                    <option
                                        t-att-value="card.id"
                                        t-att-selected="card.id === state.selectedCardId ? true : undefined"
                                    >
                                        <t t-esc="card.name"/>
                                    </option>
                                </t>
                            </t>
                            <t t-else="">
                                <option value="">Sin tarjetas configuradas</option>
                            </t>
                        </select>
                    </div>

                    <div class="col-6 mb-3">
                        <label class="form-label">Cuotas</label>
                        <select class="form-select" t-on-change="onChangeInstallment">
                            <t t-if="state.installments.length">
                                <t t-foreach="state.installments" t-as="installment" t-key="installment.id">
                                    <option
                                        t-att-value="installment.id"
                                        t-att-selected="installment.id === state.selectedInstallmentId ? true : undefined"
                                    >
                                        <t t-esc="installment.name"/>
                                    </option>
                                </t>
                            </t>
                            <t t-else="">
                                <option value="">Sin planes configurados</option>
                            </t>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Monto neto</label>
                    <input
                        type="number"
                        class="form-control"
                        t-att-value="state.netAmount"
                        t-on-input="onChangeNetAmount"
                    />
                </div>

                <div class="row">
                    <div class="col-3 mb-3">
                        <label class="form-label">Coeficiente</label>
                        <input
                            class="form-control"
                            t-att-value="state.coefficient"
                            readonly="readonly"
                        />
                    </div>
                    <div class="col-3 mb-3">
                        <label class="form-label">Recargo</label>
                        <input
                            class="form-control"
                            t-att-value="state.surcharge.toFixed(2)"
                            readonly="readonly"
                        />
                    </div>
                    <div class="col-3 mb-3">
                        <label class="form-label">Redondeo</label>
                        <input
                            class="form-control"
                            t-att-value="state.rounding.toFixed(2)"
                            readonly="readonly"
                        />
                    </div>
                    <div class="col-3 mb-3">
                        <label class="form-label">Importe total</label>
                        <input
                            class="form-control"
                            t-att-value="state.total.toFixed(2)"
                            readonly="readonly"
                        />
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel">Cancelar</button>
                <button
                    class="btn btn-primary"
                    t-on-click="confirm"
                    t-att-disabled="(!state.selectedCardId || !state.selectedInstallmentId) ? true : undefined"
                >
                    Confirmar
                </button>
            </t>
        </Dialog>
    </t>

</templates>
