<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_pci" model="ir.ui.view">
        <field name="name">pos.order.form.pci</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Tarjetas / Cuotas">
                    <group>
                        <field name="pci_net_total" readonly="1"/>
                        <field name="pci_surcharge_total" readonly="1"/>
                        <field name="pci_debit_note_move_id" readonly="1"/>
                    </group>
                    <field name="payment_ids" readonly="1">
                        <tree>
                            <field name="payment_method_id"/>
                            <field name="amount"/>
                            <field name="pci_payment_method_label"/>
                            <field name="pci_card_brand_id"/>
                            <field name="pci_installment_plan_id"/>
                            <field name="pci_installments"/>
                            <field name="pci_net_amount"/>
                            <field name="pci_surcharge_amount"/>
                            <field name="pci_total_amount"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
