<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_card_installment_plan_tree" model="ir.ui.view">
        <field name="name">pos.card.installment.plan.tree</field>
        <field name="model">pos.card.installment.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="installments"/>
                <field name="surcharge_percent"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_card_installment_plan_form" model="ir.ui.view">
        <field name="name">pos.card.installment.plan.form</field>
        <field name="model">pos.card.installment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="brand_id"/>
                        <field name="installments"/>
                        <field name="surcharge_percent"/>
                        <field name="payment_method_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_card_installment_plan" model="ir.actions.act_window">
        <field name="name">Planes de cuotas POS</field>
        <field name="res_model">pos.card.installment.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pos_card_installment_plan"
              name="Cuotas"
              parent="point_of_sale.menu_point_of_sale_configuration"
              action="action_pos_card_installment_plan"
              sequence="97"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
