<odoo>
    <record id="view_pos_payment_method_form_pos_card_installment" model="ir.ui.view">
        <field name="name">pos.payment.method.form.pos.card.installment</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="Tarjeta / Cuotas POS">
                    <field name="pci_use_installments"/>
                    <field name="pci_force_invoice" invisible="not pci_use_installments"/>
                    <field name="pci_payment_method_line_id" invisible="not pci_use_installments"/>
                    <field name="pci_debit_note_journal_id" invisible="not pci_use_installments"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
