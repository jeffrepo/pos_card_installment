<odoo>
    <record id="view_pos_payment_tree_pos_card_installment" model="ir.ui.view">
        <field name="name">pos.payment.tree.pos.card.installment</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="card_id" optional="show"/>
                <field name="installment_id" optional="show"/>
                <field name="net_amount" optional="show"/>
                <field name="financing_surcharge" optional="show"/>
                <field name="pci_debit_note_move_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form_pos_card_installment" model="ir.ui.view">
        <field name="name">pos.payment.form.pos.card.installment</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Tarjeta / Cuotas">
                    <field name="card_id"/>
                    <field name="installment_id"/>
                    <field name="net_amount"/>
                    <field name="financing_surcharge" readonly="1"/>
                    <field name="pci_debit_note_move_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
